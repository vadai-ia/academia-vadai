# ---------------------------------------------------------------------------
# VADAI ACADEMIA - variables de entorno
# Copia este archivo a .env.local y llena los valores.
# .env.local NUNCA se commitea. Ver docs/M0-SETUP.md paso 6.
# ---------------------------------------------------------------------------

# --- Supabase (M0) ---------------------------------------------------------
# Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Settings -> API -> Project API keys -> anon / public
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Settings -> API -> Project API keys -> service_role  (SECRETO, solo server)
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Settings -> Database -> Connection string -> Session pooler (puerto 5432).
# SOLO local. Nunca se carga en Vercel, nunca lleva prefijo NEXT_PUBLIC_.
# La usan scripts/migrate.mjs y scripts/seed.mjs. Ver docs/M0-SETUP.md.
SUPABASE_DB_URL=

# --- Resend (correo transaccional) -----------------------------------------
# Solo para diagnóstico y pruebas de envío con scripts/check-resend.mjs.
# La app NO manda correo por su cuenta (§7.3): lo hace Supabase Auth con estas
# mismas credenciales guardadas en su dashboard.
# Buzón real al que check-m0 manda su prueba de envío. Sin esto la prueba va a
# una dirección QA que no recibe correo, y cada corrida genera un rebote.
EMAIL_PRUEBA_SMTP=

RESEND_API_KEY=

# --- Stripe (M9) -----------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Bunny Stream (M3/M4) --------------------------------------------------
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_TOKEN_KEY=
BUNNY_STREAM_CDN_HOSTNAME=

# Sal del hash de IP de la cuota de encuestas en vivo (M12). Solo servidor.
# Opcional: si falta, se deriva de SUPABASE_SERVICE_ROLE_KEY. Se define aparte
# para poder rotarla sin tocar la llave de Supabase.
ENCUESTAS_IP_SALT=
