# ---------------------------------------------------------------------------
# VADAI ACADEMIA - variables de entorno
# Copia este archivo a .env.local y llena los valores.
# .env.local NUNCA se commitea. Ver docs/M0-SETUP.md paso 6.
# ---------------------------------------------------------------------------

# --- Supabase (M0) ---------------------------------------------------------
# Estas dos son públicas por diseño (viajan en el bundle del navegador), por eso
# van ya llenas. Lo que protege los datos es RLS, no esconder esta llave.
# Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://mtrojwqwnuzzcgtmmoop.supabase.co
# Settings -> API Keys -> Publishable key (sb_publishable_...). Es el reemplazo
# de la anon key vieja; el código la sigue leyendo con este nombre.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_m_s2_u66rJ786toh-JKl6w_QfHR8SEg
# Settings -> API Keys -> Secret key (sb_secret_...) o la service_role vieja.
# SECRETO, solo server. Esta NUNCA se escribe en este archivo: va en .env.local.
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Settings -> Database -> Connection string -> Session pooler (puerto 5432).
# SOLO local. Nunca se carga en Vercel, nunca lleva prefijo NEXT_PUBLIC_.
# La usan scripts/migrate.mjs y scripts/seed.mjs. Ver docs/M0-SETUP.md.
SUPABASE_DB_URL=

# --- Resend (correo transaccional) -----------------------------------------
# Los correos de la academia (bienvenida y recuperación) los manda NUESTRO código
# por la API de Resend (lib/correo/resend.ts), no el SMTP de Supabase. Supabase
# solo genera el token del enlace. Sin RESEND_API_KEY las altas funcionan igual,
# pero no sale ningún correo y el admin lo avisa.
RESEND_API_KEY=
CORREO_REMITENTE=noreply@automail.vadai.com.mx
CORREO_REMITENTE_NOMBRE=VADAI Academia
# A dónde llegan las respuestas. El remitente es un noreply@ sin buzón, y la
# bienvenida dice "responde este correo y te ayudamos". Opcional: si falta, se usa
# ayuda@vadai.com.mx.
CORREO_RESPONDER_A=ayuda@vadai.com.mx

# Buzón real al que check-m0 manda su prueba de envío. Sin esto la prueba va a
# una dirección QA que no recibe correo, y cada corrida genera un rebote.
EMAIL_PRUEBA_SMTP=

# --- Stripe (M9) -----------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Bunny Stream (M3/M4) --------------------------------------------------
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_TOKEN_KEY=
BUNNY_STREAM_CDN_HOSTNAME=

# Sal del hash de IP de la cuota de encuestas en vivo (M12). Solo servidor.
# Opcional: si falta, se deriva de SUPABASE_SERVICE_ROLE_KEY. Se define aparte
# para poder rotarla sin tocar la llave de Supabase.
ENCUESTAS_IP_SALT=
